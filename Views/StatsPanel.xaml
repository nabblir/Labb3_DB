<UserControl x:Class="Labb3_DB.Views.StatsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb3_DB.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <materialDesign:Card Margin="5" Padding="5" Background="#4A5568" BorderBrush="Black">
        <StackPanel>
            <TextBlock Text="Kingdom Statistics" 
                      Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                      Margin="5,5,5,5" 
                      HorizontalAlignment="Center"
                      Foreground="White"/>

            <!-- Gold Chart -->
            <TextBlock Text="💰 Gold" 
                      Style="{StaticResource MaterialDesignBody1TextBlock}"
                      Margin="5,0,5,0" 
                      Foreground="Gold"/>
            <lvc:CartesianChart 
                Series="{Binding GoldSeries}"
                YAxes="{Binding GoldAxes}"
                Height="170"
                Margin="5,0,5,5"
                TooltipPosition="Hidden"/>
            <Separator Foreground="#3F000000" Background="#3FFFFFFF">   </Separator>
            <!-- Happiness Chart -->
            <TextBlock Text="😊 Happiness" 
                      Style="{StaticResource MaterialDesignBody1TextBlock}"
                      Margin="5,0,5,0" 
                      Foreground="LawnGreen"/>
            <lvc:CartesianChart 
                Series="{Binding HappinessSeries}"
                YAxes="{Binding HappinessAxes}"
                Height="170"
                TooltipPosition="Hidden"
                Margin="5,0,5,5"/>
        </StackPanel>
    </materialDesign:Card>
</UserControl>