<UserControl x:Class="Labb3_DB.Views.KingdomSelectionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="500"
             Height="450">

    <materialDesign:Card Padding="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="Select Your Kingdom"
                       Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" Foreground="White"/>

            <!-- Create New Button -->
            <Button Grid.Row="1"
                    Content="CREATE NEW KINGDOM"
                    Command="{Binding CreateNewCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,0,16"
                    Height="48"/>

            <!-- Saved Kingdoms List -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SavedKingdoms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding KingdomName}"
                                                      FontSize="16"
                                                      FontWeight="Bold"
                                                      Margin="0,0,0,4"/>
                                            <TextBlock FontSize="12"
                                                      Foreground="{DynamicResource MaterialDesignBodyLight}">
                                                <Run Text="Gold:"/>
                                                <Run Text="{Binding Gold, StringFormat=N0}"/>
                                                <Run Text=" | Population:"/>
                                                <Run Text="{Binding Population}"/>
                                                <Run Text="/"/>
                                                <Run Text="{Binding MaxPopulation}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding LastSaved, StringFormat='Last saved: {0:g}'}"
                                                      FontSize="11"
                                                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                      Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                               Content="LOAD"
                                               Command="{Binding DataContext.SelectKingdomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Cancel Button -->
            <Button Grid.Row="3"
                    Content="CANCEL"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Center"/>
        </Grid>
    </materialDesign:Card>
</UserControl>